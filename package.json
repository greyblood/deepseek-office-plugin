{
  "name": "deepseek-office-plugin",
  "version": "0.8.1",
  "description": "DeepSeek Excel Studio — self-contained in-app Excel Editor & local Excel automation MCP plugin bundle for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "excel",
    "spreadsheet-editor",
    "mcp",
    "office"
  ],
  "files": [
    "index.js",
    "client.js",
    "mcp-server.js",
    "lib",
    "cordis.patch.yml",
    "examples",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greyblood/deepseek-office-plugin.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0"
  }
}
